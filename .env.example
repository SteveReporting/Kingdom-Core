# Required: Discord bot token from Developer Portal > Bot
TOKEN=

# Kingdom Core application ID
CLIENT_ID=1546171480952283166

# Production Kingdom Carries guild for instant command deployment.
GUILD_ID=

# Optional separate development/staging guild used by `npm run deploy:staging`.
STAGING_GUILD_ID=

# Optional exact live human/bot counters.
# ALSO enable Developer Portal > Bot > Privileged Gateway Intents > Server Members Intent.
# Leave false unless that Discord toggle is enabled, otherwise Discord will reject the gateway connection.
ENABLE_MEMBER_STATS_INTENT=false

# Legacy public Google Forms application links. UIpgrade uses Discord-native applications,
# but these can remain configured for archive/reference purposes.
STAFF_APPLICATION_URL=
CARRIER_APPLICATION_URL=
CREATOR_APPLICATION_URL=

# Legacy staff-only Google Forms response / linked Google Sheet URLs.
STAFF_APPLICATION_RESPONSES_URL=
CARRIER_APPLICATION_RESPONSES_URL=
CREATOR_APPLICATION_RESPONSES_URL=

# UIpgrade application acceptance role overrides.
# Comma-separated Discord role IDs. If blank, Staff defaults to Watchman and Carrier
# defaults to Squire • Carrier Trial. Creator has no fallback role, so configure it here.
STAFF_ACCEPT_ROLE_IDS=
CARRIER_ACCEPT_ROLE_IDS=
CREATOR_ACCEPT_ROLE_IDS=

# Staff / creator onboarding links sent privately after an accepted application.
STAFF_ONBOARDING_URL=
STAFF_HANDBOOK_URL=
CREATOR_ONBOARDING_URL=
CREATOR_GUIDELINES_URL=

# Carrier Department document library links. Accepted Knight applicants receive configured
# links from this set in their onboarding DM.
CARRIER_ORBAT_URL=
CARRIER_GOVERNANCE_URL=
CARRIER_RECRUITMENT_SOP_URL=
CARRIER_MANAGEMENT_SOP_URL=
CARRIER_FORMS_URL=
CARRIER_CONTROL_SHEET_URL=

# Optional legacy/private platform API. Keep loopback-only unless you intentionally use it.
ENABLE_PLATFORM_API=false
API_HOST=127.0.0.1
API_PORT=8787
API_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# KINGDOM ECOSYSTEM — systems 1-20 / Kingdom Nexus control plane
# Free-first defaults: same Node process, same Oracle VM, local JSON state, local
# Vault backups, installable PWA, Cloudflare Workers/VPC edge. No paid database,
# cache, app store or custom domain is required for the current production design.
# -----------------------------------------------------------------------------
KINGDOM_NEXUS_ENABLED=true
# Keep Core on loopback. Public Nexus reaches it only through Cloudflare Workers VPC/Tunnel.
KINGDOM_NEXUS_HOST=127.0.0.1
KINGDOM_NEXUS_PORT=8791
# Local emergency recovery only. Never enter this token into the public website, Worker vars,
# Discord, GitHub, screenshots or chat. The public Worker strips Authorization before forwarding.
KINGDOM_NEXUS_ADMIN_TOKEN=

# Discord OAuth login for Nexus.
# Exact production callback:
#   https://kingdom-nexus.davidtennyson846.workers.dev/auth/discord/callback
# Add that exact callback in Discord Developer Portal > OAuth2 > Redirects.
# CLIENT_ID above is reused. Keep the client secret only in this VPS .env; never commit it.
DISCORD_OAUTH_CLIENT_SECRET=
KINGDOM_NEXUS_PUBLIC_URL=https://kingdom-nexus.davidtennyson846.workers.dev

# Optional additional operator allowlists. Administrator / Manage Guild are operators by default.
# Values are comma-separated Discord IDs. Leave blank unless you intentionally need them.
KINGDOM_NEXUS_OPERATOR_ROLE_IDS=
KINGDOM_NEXUS_OPERATOR_USER_IDS=

# Nexus maintenance is throttled to >=15 minutes and automatic Vault backups to >=6 hours.
KINGDOM_NEXUS_MAINTENANCE_MS=900000
KINGDOM_NEXUS_BACKUP_MS=21600000

# Optional Launcher destinations.
KINGDOM_DISCORD_URL=
KINGDOM_GAME_URL=
KINGDOM_WEBSITE_URL=

# Optional LOCAL Kingdom AI fallback only. The production Worker has its own Workers AI binding.
# Leave these blank unless you intentionally run an Ollama-compatible /api/chat endpoint you own.
KINGDOM_AI_LOCAL_URL=
KINGDOM_AI_LOCAL_MODEL=sentient-local

# Optional external persistence/cache adapters.
# Kingdom Core + Nexus remain functional on local JSON fallback when these are blank.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
REDIS_URL=
WORKER_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# KINGDOM MARKET INTELLIGENCE
# `/value` runs on Kingdom Core and talks to the private KMI service. Keep the KMI
# service on loopback when it runs on the same VPS. Use the same API key in Core's
# KMI_API_KEY and KMI's ADMIN_API_KEY if you enable API authentication.
# -----------------------------------------------------------------------------
KMI_API_URL=http://127.0.0.1:8787
KMI_API_KEY=
KMI_API_TIMEOUT_MS=12000

# Runtime environment marker.
KINGDOM_ENV=production
