# Required: Discord bot token from Developer Portal > Bot
TOKEN=

# Kingdom Core application ID
CLIENT_ID=1546171480952283166

# Production Kingdom Carries guild for instant command deployment.
GUILD_ID=

# Optional separate development/staging guild used by `npm run deploy:staging`.
STAGING_GUILD_ID=

# Optional exact live human/bot counters.
# ALSO enable Developer Portal > Bot > Privileged Gateway Intents > Server Members Intent.
# Leave false unless that Discord toggle is enabled, otherwise Discord will reject the gateway connection.
ENABLE_MEMBER_STATS_INTENT=false

# Legacy public Google Forms application links. UIpgrade uses Discord-native applications,
# but these can remain configured for archive/reference purposes.
STAFF_APPLICATION_URL=
CARRIER_APPLICATION_URL=
CREATOR_APPLICATION_URL=

# Legacy staff-only Google Forms response / linked Google Sheet URLs.
STAFF_APPLICATION_RESPONSES_URL=
CARRIER_APPLICATION_RESPONSES_URL=
CREATOR_APPLICATION_RESPONSES_URL=

# UIpgrade application acceptance role overrides.
# Comma-separated Discord role IDs. If blank, Staff defaults to Watchman and Carrier
# defaults to Squire • Carrier Trial. Creator has no fallback role, so configure it here.
STAFF_ACCEPT_ROLE_IDS=
CARRIER_ACCEPT_ROLE_IDS=
CREATOR_ACCEPT_ROLE_IDS=

# Staff / creator onboarding links sent privately after an accepted application.
STAFF_ONBOARDING_URL=
STAFF_HANDBOOK_URL=
CREATOR_ONBOARDING_URL=
CREATOR_GUIDELINES_URL=

# Carrier Department document library links. Accepted Knight applicants receive configured
# links from this set in their onboarding DM.
CARRIER_ORBAT_URL=
CARRIER_GOVERNANCE_URL=
CARRIER_RECRUITMENT_SOP_URL=
CARRIER_MANAGEMENT_SOP_URL=
CARRIER_FORMS_URL=
CARRIER_CONTROL_SHEET_URL=

# Kingdom Core v4 optional HTTP API + live WebSocket dashboard.
# Defaults to OFF and localhost-only so nothing is exposed accidentally.
ENABLE_PLATFORM_API=false
API_HOST=127.0.0.1
API_PORT=8787
# Required only for /api/admin/* endpoints. Use a long random value.
API_ADMIN_TOKEN=

# Optional external persistence/cache adapters.
# The bot stays fully functional on its JSON fallback when these are blank.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
REDIS_URL=
WORKER_INTERVAL_MS=60000

# Runtime environment marker.
KINGDOM_ENV=production
